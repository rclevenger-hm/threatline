# Threatline runs in demo mode with no credentials required.
THREATLINE_HOST=127.0.0.1
THREATLINE_PORT=8080
# Comma-separated. Example: jira,github,grafana,zabbix once configured.
THREATLINE_PROVIDERS=demo

# Local workspace data. Runtime files are ignored by Git.
# THREATLINE_CONFIG_DIR defaults to ~/.threatline when omitted.
THREATLINE_CONFIG_DIR=
THREATLINE_DATA_DIR=.runtime
THREATLINE_TIMEZONE=UTC

# Jira provider. Use either a Server/Data Center personal access token or
# Atlassian Cloud email + API token. Do not commit real credentials.
THREATLINE_JIRA_BASE_URL=
THREATLINE_JIRA_JQL=resolution IS EMPTY ORDER BY priority DESC, updated DESC
THREATLINE_JIRA_PAT=
THREATLINE_JIRA_EMAIL=
THREATLINE_JIRA_API_TOKEN=
THREATLINE_JIRA_VERIFY_SSL=true
THREATLINE_JIRA_TIMEOUT=30
THREATLINE_JIRA_MAX_RESULTS=500

# GitHub provider. Works with GitHub.com or GitHub Enterprise Server.
# Repositories are comma-separated owner/name values.
THREATLINE_GITHUB_TOKEN=
THREATLINE_GITHUB_REPOSITORIES=
THREATLINE_GITHUB_API_URL=https://api.github.com
THREATLINE_GITHUB_WEB_URL=https://github.com
THREATLINE_GITHUB_VERIFY_SSL=true
THREATLINE_GITHUB_TIMEOUT=30
THREATLINE_GITHUB_MAX_CHANGES=100
THREATLINE_GITHUB_MAX_RUNBOOKS=100

# Grafana provider. Dashboard entries are semicolon-separated and use either
# uid|title or service_id|uid|title. Links remain local configuration and do
# not require Grafana API credentials.
THREATLINE_GRAFANA_URL=
THREATLINE_GRAFANA_DASHBOARDS=
THREATLINE_GRAFANA_ORG_ID=
THREATLINE_GRAFANA_SERVICE_VARIABLE=service
THREATLINE_GRAFANA_FROM=now-6h
THREATLINE_GRAFANA_TO=now

# Optional Zabbix provider. Active problems are normalized into Threatline
# alerts. The service tag controls correlation with work-item service IDs.
THREATLINE_ZABBIX_URL=
THREATLINE_ZABBIX_TOKEN=
THREATLINE_ZABBIX_SERVICE_TAG=service
THREATLINE_ZABBIX_VERIFY_SSL=true
THREATLINE_ZABBIX_TIMEOUT=30
THREATLINE_ZABBIX_MAX_PROBLEMS=200
