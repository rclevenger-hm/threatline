# Threatline runs in demo mode with no credentials required.
THREATLINE_HOST=127.0.0.1
THREATLINE_PORT=8080
# Comma-separated. Example: jira,github once both are configured.
THREATLINE_PROVIDERS=demo

# Jira provider. Use either a Server/Data Center personal access token or
# Atlassian Cloud email + API token. Do not commit real credentials.
THREATLINE_JIRA_BASE_URL=
THREATLINE_JIRA_JQL=resolution IS EMPTY ORDER BY priority DESC, updated DESC
THREATLINE_JIRA_PAT=
THREATLINE_JIRA_EMAIL=
THREATLINE_JIRA_API_TOKEN=
THREATLINE_JIRA_VERIFY_SSL=true
THREATLINE_JIRA_TIMEOUT=30
THREATLINE_JIRA_MAX_RESULTS=500
